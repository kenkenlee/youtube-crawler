# Application
APP_NAME=YouTube Crawler
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/database.db

# YouTube API (Optional - for faster crawling)
YOUTUBE_API_KEY=your_youtube_api_key_here

# AI Summarization - Choose ONE provider:
# (Alternatively set these from the web UI: /settings)
# LLM_PROVIDER=openrouter   # openrouter | deepseek | openai

# Option 1: OpenRouter (recommended - works globally, cheap)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
USE_OPENROUTER=True

# Option 2: DeepSeek direct
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# USE_DEEPSEEK=True

# Option 3: OpenAI (if available in your region)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4
# USE_OPENAI=True

# Crawler Settings
MAX_VIDEOS_PER_CHANNEL=30
AUTO_SUMMARIZE=True
# Automatically fetch transcripts during crawling/summarisation. When False,
# transcripts are only fetched on manual request (the "Get Transcript" action).
AUTO_FETCH_TRANSCRIPT=True
ENABLE_SCHEDULER=True

# Admin UI password (required for /settings auth; no hardcoded default)
ADMIN_PASSWORD=change-me-before-first-login
